---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { allYears, FIRST_YEAR, LAST_YEAR } from '../lib/year-schema.mjs';

const entries = await getCollection('years');
const have = new Map(entries.map((e) => [e.data.year, e.data]));
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${base.endsWith('/') ? '' : '/'}${path}`.replace(/\/{2,}/g, '/');

const years = allYears();

const decades: { label: string; years: number[] }[] = [];
for (const year of years) {
  const label = `${Math.floor(year / 10) * 10}s`;
  const last = decades[decades.length - 1];
  if (last && last.label === label) last.years.push(year);
  else decades.push({ label, years: [year] });
}
---

<Base
  title="Year Context"
  description="What the world was like in every year from 1920 to 2025, for anyone about to watch a film from one of them."
>
  <main class="sheet">
    <div class="topbar">
      <span class="topbar__home">Year Context</span>
      <span class="topbar__nav">{FIRST_YEAR}–{LAST_YEAR} · {years.length} years</span>
    </div>

    <header class="masthead">
      <h1>How far away is your film?</h1>
      <p>
        One data sheet per year, 1920 to 2025. Each one measures the distance between a film's
        world and yours: the president, the prices, the songs, the news its first audience carried
        into the theater.
      </p>
    </header>

    <nav class="decades" aria-label="Years">
      {
        decades.map((decade) => (
          <div class="decade">
            <div class="decade__label">{decade.label}</div>
            <ul class="decade__years">
              {decade.years.map((year) => {
                const entry = have.get(year);
                return (
                  <li>
                    {entry ? (
                      <a class="yearchip" href={href(`year/${year}`)} title={entry.headline}>
                        {year}
                      </a>
                    ) : (
                      <span class="yearchip yearchip--empty" aria-label={`${year}, not written yet`}>
                        {year}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </nav>

    <footer class="pagefoot">
      <span>Every fact is sourced, and every page states the basis its figures use.</span>
      <a href={href('corrections')}>Something wrong? Send a correction</a>
    </footer>
  </main>
</Base>
