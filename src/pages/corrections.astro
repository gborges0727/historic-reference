---
import Base from '../layouts/Base.astro';

/**
 * The only place a GitHub URL is written. astro.config.mjs holds the only path.
 * Two constants, one migration each if the repo ever moves.
 */
const REPO = 'https://github.com/gborges0727/historic-reference';
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${base.endsWith('/') ? '' : '/'}${path}`.replace(/\/{2,}/g, '/');
---

<Base
  title="Corrections | Year Context"
  description="How to report a wrong fact, and what happens to it."
>
  <main class="sheet">
    <div class="topbar">
      <a class="topbar__home" href={href('')}>Year Context</a>
      <span class="topbar__nav"><a href={href('')}>all years</a></span>
    </div>

    <h1 class="pagetitle">Corrections</h1>

    <section class="block">
      <h2 class="block__label"><span>How it</span><span>works</span></h2>
      <div class="copy">
        <p>
          Every page here is generated from sourced data, and generated history contains errors.
          What separates a record people can use from one they cannot is whether the errors are
          visible, sourced, and fixable.
        </p>
        <p>
          Each fact carries a source link. If a fact is wrong, open an issue with the year, the
          fact label, what is wrong, and a source. Corrections are applied to the data file and the
          source URL is replaced in the same change.
        </p>
        <p>
          <a href={`${REPO}/issues/new?template=correction.yml`}>Open a correction issue</a>, or
          read <a href={`${REPO}/blob/main/CORRECTIONS.md`}>CORRECTIONS.md</a> for what has already
          been fixed.
        </p>
      </div>
    </section>

    <section class="block">
      <h2 class="block__label"><span>What the</span><span>figures mean</span></h2>
      <div class="copy">
        <p>
          Some figures cannot be pinned down and are labelled rather than guessed. Box office is
          the clearest case, and it changes twice. Through 1976 the tables report rentals, the
          distributor share, roughly half the ticket-window total. From 1977 they report gross.
          From 1988 that gross is worldwide rather than North American, which is a wider gap than
          the first change: the biggest film of 1987 and the biggest of 1988 are not measured the
          same way. Every page states both the basis and the territory it used, and where no basis
          could be established films are ranked with no amounts at all.
        </p>
      </div>
    </section>

    <footer class="pagefoot">
      <a href={href('')}>Back to the years</a>
    </footer>
  </main>
</Base>
