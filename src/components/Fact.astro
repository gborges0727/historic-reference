---
/**
 * One fact. Array values render as a list, the date sits with the label, and the
 * source is a link when there is one. A fact with no source renders no link
 * rather than an empty one, which only happens on qualitative culture facts.
 */
interface Props {
  fact: {
    id: string;
    label: string;
    value: string | number | string[];
    detail?: string;
    date?: string;
    source?: string;
  };
}

const { fact } = Astro.props;
const values = Array.isArray(fact.value) ? fact.value : null;
---

<li class="fact" id={fact.id}>
  <div class="fact__label">
    <span>{fact.label}</span>
    {fact.date && <span class="fact__date">{fact.date}</span>}
  </div>
  {
    values ? (
      <ul class="fact__list">
        {values.map((v) => (
          <li>{v}</li>
        ))}
      </ul>
    ) : (
      <div class="fact__value">{fact.value}</div>
    )
  }
  {fact.detail && <p class="fact__detail">{fact.detail}</p>}
  {
    fact.source && (
      <a class="fact__source" href={fact.source} rel="nofollow noopener">
        source
      </a>
    )
  }
</li>
